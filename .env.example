# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Gemini API (provided key below - already active)
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# App Configuration
NEXT_PUBLIC_APP_ID=cv-tailor-pro

# ========================================
# GETTING YOUR FIREBASE CREDENTIALS
# ========================================
# 
# 1. Go to https://console.firebase.google.com
# 2. Select your project
# 3. Click ⚙️ Settings in left menu
# 4. Select "Project Settings"
# 5. In "Your Apps" section, find your web app
# 6. Copy the config values to above
#
# YOUR CONFIG WILL LOOK LIKE:
# {
#   "apiKey": "AIza...",
#   "authDomain": "your-app.firebaseapp.com",
#   "projectId": "your-app-id",
#   "storageBucket": "your-app.appspot.com",
#   "messagingSenderId": "123456789",
#   "appId": "1:123456789:web:abc123..."
# }
#
# Map these to the env vars above.
# ========================================
